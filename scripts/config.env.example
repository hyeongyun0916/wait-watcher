# Copy to ~/waits/config.env (or $WAITS_HOME/config.env) and fill in. Sourced by waits.sh.
ART_URL=https://claude.ai/artifact/XXXXXXXXXXXXXXXXXXXXXX   # your published board.html (capabilities db + user)
USER_SLACK_ID=U0XXXXXXXXX                                   # Slack profile > ⋮ > Copy member ID
GH_LOGIN=your-github-login
JIRA_CLOUD_ID=                                              # optional: Atlassian site cloudId
DEFAULT_REPO=                                               # optional: owner/repo for bare PR numbers
# SLACK_MENTION='<@U0XXXXXXXXX>'                            # optional: mention yourself in every post
# MODEL=claude-haiku-5-5  HELPER_MODEL=claude-haiku-5-5  INTERVAL=1200  FULL_EVERY=3600  FRESH_HOURS=24  STUCK_AFTER=18  FAIL_ALERT_AFTER=2
# WAITS_ENTRYPOINT=claude-vscode                            # entrypoint that gives headless runs ArtifactData
